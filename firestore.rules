rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 第一版：所有 @twclc.org 已驗證 Google 帳號可填報；只有以下兩個帳號能核准／解鎖。
    function staff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@twclc[.]org$');
    }
    function superuser() {
      return staff() && (
        request.auth.token.email == 'darren.lin@twclc.org'
        || request.auth.token.email == 'darren710404@twclc.org'
      );
    }
    function draftOrSubmitted() {
      return request.resource.data.status in ['draft', 'submitted'];
    }
    // 將管理員確認後的鎖定實際施加在伺服器，不依賴前端按鈕隱藏。
    match /christmas2026/main/sections/{sectionId} {
      allow get, list: if staff();
      allow create: if staff() && (superuser() || draftOrSubmitted())
        && request.resource.data.updatedBy == request.auth.token.email
        && (request.resource.data.status != 'submitted'
          || request.resource.data.lastSubmittedBy == request.auth.token.email);
      allow update: if superuser()
        || (staff() && resource.data.status != 'confirmed'
          && draftOrSubmitted()
          && request.resource.data.updatedBy == request.auth.token.email
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvedBy','approvedAt'])
          && (request.resource.data.status != 'submitted'
            || request.resource.data.lastSubmittedBy == request.auth.token.email));
      allow delete: if false;
    }
    match /christmas2026/main/counts/{countId} {
      allow get, list: if staff();
      allow create: if staff()
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.lastSubmittedBy == request.auth.token.email
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 5000;
      allow update: if superuser();
      allow delete: if superuser();
    }
    match /christmas2026/main/photos/{photoId} {
      allow get, list: if staff();
      allow create: if staff()
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.sectionId in ['meal-jiangcui','meal-xinzhuang','meal-linkou']
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 290000
        && request.resource.data.dataUrl.matches('data:image/jpeg;base64,.*');
      allow update: if false;
      allow delete: if superuser();
    }
    // 公開餐點：任何訪客只可新增格式受限的餐點提案，無法更動或刪除他人的資料。
    // 注意：免登入公開寫入仍可能遭到灌資料；正式對外大量傳播前建議加 App Check/Turnstile 等防濫用控制。
    match /christmas2026/main/publicMeals/{mealId} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll([
          'branch','service','mealName','unitPrice','totalBudget','note','imageData','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'branch','service','mealName','unitPrice','totalBudget','note','imageData','createdAt'
        ])
        && request.resource.data.branch in ['江翠','新莊','林口']
        && request.resource.data.service in ['晚崇','青崇','主日']
        && (request.resource.data.branch == '江翠' || request.resource.data.service != '晚崇')
        && request.resource.data.mealName is string
        && request.resource.data.mealName.size() > 0
        && request.resource.data.mealName.size() <= 80
        && request.resource.data.unitPrice is int
        && request.resource.data.unitPrice >= 0
        && request.resource.data.unitPrice <= 100000
        && request.resource.data.totalBudget is int
        && request.resource.data.totalBudget >= 0
        && request.resource.data.totalBudget <= 5000000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() > 100
        && request.resource.data.imageData.size() <= 135000
        && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if superuser();
    }
    match /christmas2026/main/logs/{logId} {
      allow get, list: if staff();
      allow create: if staff()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
