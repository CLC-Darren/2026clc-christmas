rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everyone can read submitted project data and submit new records.
    // Only these two verified Google accounts can DELETE records.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'darren.lin@twclc.org' || request.auth.token.email == 'darren710404@twclc.org');
    }

    function shortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validWorkUpdate() {
      let d = request.resource.data;
      let f = d.fields;
      return d.keys().hasAll(['sectionId', 'fields', 'reporter', 'submittedAt'])
        && d.keys().hasOnly(['sectionId', 'fields', 'reporter', 'submittedAt'])
        && d.sectionId is string
        && d.sectionId.matches('^(central|honghui-kit|honghui-sa1|honghui-sa2|honghui-su1|honghui-su2)$')
        && shortString(d.reporter, 50)
        && f is map
        && f.keys().hasOnly([
          'couponStatus', 'stickerStatus', 'giftCount', 'giftStatus',
          'refreshmentStatus', 'leader', 'team', 'people', 'notes'
        ])
        && shortString(f.get('couponStatus', ''), 50)
        && shortString(f.get('stickerStatus', ''), 50)
        && shortString(f.get('giftCount', ''), 12)
        && shortString(f.get('giftStatus', ''), 50)
        && shortString(f.get('refreshmentStatus', ''), 50)
        && shortString(f.get('leader', ''), 250)
        && shortString(f.get('team', ''), 250)
        && shortString(f.get('people', ''), 12)
        && shortString(f.get('notes', ''), 1200)
        && d.submittedAt == request.time;
    }

    // Existing project sections are readable, but new submissions are append-only.
    match /christmas2026/main/sections/{sectionId} {
      allow get, list: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /christmas2026/main/publicUpdates/{updateId} {
      allow get, list: if true;
      allow create: if validWorkUpdate() && (request.resource.data.sectionId != 'central' || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /christmas2026/main/counts/{countId} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll([
          'date', 'branch', 'service', 'reporter', 'note', 'count', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'date', 'branch', 'service', 'reporter', 'note', 'count', 'createdAt'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^2026-12-(05|06|12|13|19|20|26|27)$')
        && shortString(request.resource.data.branch, 30)
        && request.resource.data.branch.size() > 0
        && shortString(request.resource.data['service'], 70)
        && request.resource.data['service'].size() > 0
        && shortString(request.resource.data.reporter, 50)
        && request.resource.data.reporter.size() > 0
        && shortString(request.resource.data.note, 500)
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 5000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Existing photos are kept for compatibility, but new meal photos go into publicMeals.
    match /christmas2026/main/photos/{photoId} {
      allow get, list: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /christmas2026/main/publicMeals/{mealId} {
      allow get, list: if true;
      // 舊 collection 僅保留公開讀取和管理員刪除，避免再新增重複的場次。
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 餐點額外相片需與新餐點在同一個 batch 建立，避免匿名附加到既有餐點。
    function validNewMealPhoto(mealId) {
      let parent = getAfter(/databases/$(database)/documents/christmas2026/main/publicMeals/$(mealId)).data;
      let d = request.resource.data;
      return d.keys().hasAll(['imageData', 'position', 'createdAt'])
        && d.keys().hasOnly(['imageData', 'position', 'createdAt'])
        && d.imageData is string
        && d.imageData.size() > 100
        && d.imageData.size() <= 135000
        && d.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && d.position is int
        && d.position >= 1
        && d.position < 20
        && d.createdAt == request.time
        && parent.createdAt == request.time
        && parent.photoCount is int
        && d.position < parent.photoCount;
    }

    match /christmas2026/main/publicMeals/{mealId}/photos/{photoId} {
      allow get, list: if true;
      allow create: if validNewMealPhoto(mealId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Only verified superusers may upload/replace/delete the two central-supplies images.
    // Anyone can view these two images without signing in.
    match /christmas2026/main/centralAssets/{assetId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && (assetId == 'sticker' || assetId == 'voucher')
        && request.resource.data.keys().hasAll(['imageData', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['imageData', 'updatedAt', 'updatedBy'])
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() > 100
        && request.resource.data.imageData.size() <= 220000
        && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isAdmin() && (assetId == 'sticker' || assetId == 'voucher');
    }

    // Album photos: each image has a separate document, so albums can grow without
    // hitting Firestore's 1 MiB per-document limit. Public read, admins write only.
    match /christmas2026/main/centralAssets/{assetId}/photos/{photoId} {
      allow get, list: if true;
      allow create: if isAdmin()
        && (assetId == 'sticker' || assetId == 'voucher')
        && request.resource.data.keys().hasAll(['imageData', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['imageData', 'createdAt', 'createdBy'])
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() > 100
        && request.resource.data.imageData.size() <= 180000
        && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if false;
      allow delete: if isAdmin() && (assetId == 'sticker' || assetId == 'voucher');
    }

    // Private legacy audit logs: new public submissions do not write to this collection.
    match /christmas2026/main/logs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    // 七個固定場次，每個 slot 只可有一筆正式餐點。
    // 第一次建立不要求登入；之後只允許驗證後的 Superuser 更新。
    function validMealSlot() {
      let d = request.resource.data;
      return d.keys().hasAll(['mealName','unitPrice','totalBudget','note','imageData','images','createdAt','updatedAt'])
        && d.keys().hasOnly(['mealName','unitPrice','totalBudget','note','imageData','images','createdAt','updatedAt','lastApprovedBy'])
        && shortString(d.mealName,80) && d.mealName.size() > 0
        && d.unitPrice is int && d.unitPrice >= 0 && d.unitPrice <= 100000
        && d.totalBudget is int && d.totalBudget >= 0 && d.totalBudget <= 5000000
        && shortString(d.note,500)
        && d.images is list && d.images.size() >= 1 && d.images.size() <= 20
        && d.imageData is string && d.imageData.size() > 100 && d.imageData.size() <= 100000
        && d.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && d.images[0] == d.imageData;
    }
    function validMealSlotId(slotId) {
      return slotId.matches('^(jiangcui-sunday|jiangcui-youth|jiangcui-evening|xinzhuang-sunday|xinzhuang-youth|linkou-sunday|linkou-youth)$');
    }
    match /christmas2026/main/mealSlots/{slotId} {
      allow get,list: if true;
      allow create: if validMealSlotId(slotId) && validMealSlot() && (
        isAdmin() || (
          request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && !request.resource.data.keys().hasAny(['lastApprovedBy'])
        )
      );
      allow update: if isAdmin() && validMealSlot();
      allow delete: if isAdmin();
    }
    // 認證以外的所有訪客只可建立待審核版本，不能直接覆蓋正式內容。
    function validMealChange() {
      let d = request.resource.data;
      return d.keys().hasAll(['slotId','mealName','unitPrice','totalBudget','note','imageData','images','reporter','status','submittedAt'])
        && d.keys().hasOnly(['slotId','mealName','unitPrice','totalBudget','note','imageData','images','reporter','status','submittedAt'])
        && validMealSlotId(d.slotId)
        && shortString(d.mealName,80) && d.mealName.size() > 0
        && d.unitPrice is int && d.unitPrice >= 0 && d.unitPrice <= 100000
        && d.totalBudget is int && d.totalBudget >= 0 && d.totalBudget <= 5000000
        && shortString(d.note,500) && shortString(d.reporter,50)
        && d.images is list && d.images.size() >= 1 && d.images.size() <= 20
        && d.imageData is string && d.imageData.size() > 100 && d.imageData.size() <= 100000
        && d.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && d.images[0] == d.imageData
        && d.status == 'pending' && d.submittedAt == request.time;
    }
    match /christmas2026/main/mealChangeRequests/{changeId} {
      // 只有持有單筆亂數 ID 者能查看單筆修改；管理者才可列出全部。
      // 此單筆讀取也供 Cloudflare Pages Function 寄送摘要時查證真實資料。
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validMealChange();
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }

  }
}
