rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everyone can read submitted project data and submit new records.
    // Only these two verified Google accounts can DELETE records.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'darren.lin@twclc.org' || request.auth.token.email == 'darren710404@twclc.org');
    }

    function shortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validWorkUpdate() {
      let d = request.resource.data;
      let f = d.fields;
      return d.keys().hasAll(['sectionId', 'fields', 'reporter', 'submittedAt'])
        && d.keys().hasOnly(['sectionId', 'fields', 'reporter', 'submittedAt'])
        && d.sectionId is string
        && d.sectionId.matches('^(central|honghui-kit|honghui-sa1|honghui-sa2|honghui-su1|honghui-su2)$')
        && shortString(d.reporter, 50)
        && f is map
        && f.keys().hasOnly([
          'couponStatus', 'stickerStatus', 'giftCount', 'giftStatus',
          'refreshmentStatus', 'leader', 'team', 'people', 'notes'
        ])
        && shortString(f.get('couponStatus', ''), 50)
        && shortString(f.get('stickerStatus', ''), 50)
        && shortString(f.get('giftCount', ''), 12)
        && shortString(f.get('giftStatus', ''), 50)
        && shortString(f.get('refreshmentStatus', ''), 50)
        && shortString(f.get('leader', ''), 250)
        && shortString(f.get('team', ''), 250)
        && shortString(f.get('people', ''), 12)
        && shortString(f.get('notes', ''), 1200)
        && d.submittedAt == request.time;
    }

    // Existing project sections are readable, but new submissions are append-only.
    match /christmas2026/main/sections/{sectionId} {
      allow get, list: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /christmas2026/main/publicUpdates/{updateId} {
      allow get, list: if true;
      allow create: if validWorkUpdate() && (request.resource.data.sectionId != 'central' || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /christmas2026/main/counts/{countId} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll([
          'date', 'branch', 'service', 'reporter', 'note', 'count', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'date', 'branch', 'service', 'reporter', 'note', 'count', 'createdAt'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^2026-12-(05|06|12|13|19|20|26|27)$')
        && shortString(request.resource.data.branch, 30)
        && request.resource.data.branch.size() > 0
        && shortString(request.resource.data['service'], 70)
        && request.resource.data['service'].size() > 0
        && shortString(request.resource.data.reporter, 50)
        && request.resource.data.reporter.size() > 0
        && shortString(request.resource.data.note, 500)
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 5000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Existing photos are kept for compatibility, but new meal photos go into publicMeals.
    match /christmas2026/main/photos/{photoId} {
      allow get, list: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /christmas2026/main/publicMeals/{mealId} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll([
          'branch', 'service', 'mealName', 'unitPrice',
          'totalBudget', 'note', 'imageData', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'branch', 'service', 'mealName', 'unitPrice',
          'totalBudget', 'note', 'imageData', 'createdAt'
        ])
        && shortString(request.resource.data.branch, 30)
        && request.resource.data.branch.size() > 0
        && shortString(request.resource.data['service'], 30)
        && request.resource.data['service'].size() > 0
        && shortString(request.resource.data.mealName, 80)
        && request.resource.data.mealName.size() > 0
        && request.resource.data.unitPrice is int
        && request.resource.data.unitPrice >= 0
        && request.resource.data.unitPrice <= 100000
        && request.resource.data.totalBudget is int
        && request.resource.data.totalBudget >= 0
        && request.resource.data.totalBudget <= 5000000
        && shortString(request.resource.data.note, 500)
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() > 100
        && request.resource.data.imageData.size() <= 135000
        && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Only verified superusers may upload/replace/delete the two central-supplies images.
    // Anyone can view these two images without signing in.
    match /christmas2026/main/centralAssets/{assetId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && (assetId == 'sticker' || assetId == 'voucher')
        && request.resource.data.keys().hasAll(['imageData', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['imageData', 'updatedAt', 'updatedBy'])
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() > 100
        && request.resource.data.imageData.size() <= 220000
        && request.resource.data.imageData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isAdmin() && (assetId == 'sticker' || assetId == 'voucher');
    }

    // Private legacy audit logs: new public submissions do not write to this collection.
    match /christmas2026/main/logs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
